@* 遵循 CRUD 交互規範：全域通用 Modal 容器 (SPA-like) *@
<div class="modal fade" id="globalModal" tabindex="-1" aria-labelledby="globalModalTitle" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" id="globalModalDialog">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="globalModalTitle">
                    <i class="bi bi-window me-2 text-primary"></i> 系統彈窗
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="globalModalBody">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">載入中...</span>
                    </div>
                    <div class="text-muted mt-2">載入模組中，請稍候...</div>
                </div>
            </div>
            <div class="modal-footer bg-light" id="globalModalFooter">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>
