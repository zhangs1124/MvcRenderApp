@model IEnumerable<MvcRenderApp.Models.InventoryItem>
@{
    ViewData["Title"] = "物料庫存管理";
    string searchKeyword = ViewBag.SearchKeyword ?? "";
    int totalCount = ViewBag.TotalCount ?? 0;
    int warningCount = ViewBag.WarningCount ?? 0;
}

<div class="container-fluid px-0">
    <!-- 頂部頁面標題與快速統計 -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="bi bi-boxes text-primary me-2"></i> 物料庫存管理清單
            </h3>
            <p class="text-muted mb-0 small">
                即時掌握庫存存量、安全水位警戒與快速出入庫作業 (SPA-like Modal 交互)
            </p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-success shadow-sm d-flex align-items-center px-3" onclick="openGlobalModal('/Inventory/CreateModal', '新增全新物料品項', 'lg');">
                <i class="bi bi-plus-lg me-1"></i> 新增物料品項
            </button>
            <span class="badge bg-white text-dark border p-2 px-3 shadow-sm d-flex align-items-center">
                <i class="bi bi-box-seam me-2 text-primary"></i> 總品項：<strong class="ms-1 fs-6" id="totalCountBadge">@totalCount</strong>
            </span>
            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle p-2 px-3 shadow-sm d-flex align-items-center">
                <i class="bi bi-exclamation-triangle me-2 text-warning"></i> 水位警戒：<strong class="ms-1 fs-6">@warningCount</strong>
            </span>
        </div>
    </div>

    <!-- 搜尋工具列卡片 -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" value="@searchKeyword" class="form-control border-start-0 ps-0" placeholder="搜尋品名、物料代碼或分類..." />
                    </div>
                </div>
                <div class="col-12 col-md-auto d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-3">
                        <i class="bi bi-search me-1"></i> 搜尋
                    </button>
                    @if (!string.IsNullOrEmpty(searchKeyword))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary px-3">
                            <i class="bi bi-x-circle me-1"></i> 清除
                        </a>
                    }
                </div>
                <div class="col-12 col-md text-md-end text-muted small">
                    <span class="badge bg-light text-secondary border">
                        <i class="bi bi-shield-check me-1 text-success"></i> 遵循 RWD 防擠壓標準表格
                    </span>
                </div>
            </form>
        </div>
    </div>

    <!-- 庫存資料主表格 (遵循 RWD 防擠壓標準 min-width: 850px + nowrap) -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="responsive-table-wrapper">
                <table class="table table-hover align-middle mb-0" id="inventoryTable">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;" class="ps-4">序號</th>
                            <th style="min-width: 200px;">品名規格 / 物料代碼</th>
                            <th style="width: 140px;">物料分類</th>
                            <th style="width: 160px;">現存量 / 水位</th>
                            <th style="width: 120px;">水位狀態</th>
                            <th style="width: 160px;">最後異動</th>
                            <th style="width: 220px;" class="text-end pe-4">快速出入庫作業</th>
                        </tr>
                    </thead>
                    <tbody id="inventoryTableBody">
                        @if (!Model.Any())
                        {
                            <tr id="emptyRow">
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    查無符合條件的物料品項
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr id="row-item-@item.Id">
                                    <td class="ps-4 text-muted fw-semibold">#@item.Id</td>
                                    <td>
                                        <div class="fw-bold text-dark fs-6">@item.ItemName</div>
                                        <small class="text-muted">代碼：<code>@item.ItemCode</code></small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@item.Category</span>
                                    </td>
                                    <td>
                                        <div class="fs-6 fw-bold text-dark item-quantity" id="qty-@item.Id">
                                            @item.StockQuantity <span class="fs-6 font-normal text-muted">@item.Unit</span>
                                        </div>
                                        <small class="text-muted">安全水位：@item.SafetyStock @item.Unit</small>
                                    </td>
                                    <td>
                                        <span class="badge @item.StatusBadgeClass item-badge" id="badge-@item.Id">
                                            @item.StatusText
                                        </span>
                                    </td>
                                    <td>
                                        <small class="text-muted item-time" id="time-@item.Id">
                                            @item.LastUpdated.ToString("yyyy-MM-dd HH:mm")
                                        </small>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button type="button" class="btn btn-outline-success" onclick="openGlobalModal('/Inventory/AdjustStockModal?id=@item.Id&actionType=in', '物料快速入庫作業');">
                                                <i class="bi bi-plus-circle me-1"></i> 入庫
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" onclick="openGlobalModal('/Inventory/AdjustStockModal?id=@item.Id&actionType=out', '物料快速出庫作業');" @(item.StockQuantity <= 0 ? "disabled" : "")>
                                                <i class="bi bi-dash-circle me-1"></i> 出庫
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    /**
     * AJAX 提交新增物料 (SPA-like 無刷新新增)
     */
    function submitCreateItem(e) {
        e.preventDefault();
        const form = document.getElementById("createItemForm");
        const submitBtn = document.getElementById("btnSubmitCreate");
        const formData = new FormData(form);

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> 建立中...';

        fetch("/Inventory/Create", {
            method: "POST",
            body: formData,
            credentials: "same-origin"
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                // 關閉 Modal
                const modalEl = document.getElementById("globalModal");
                const bsModal = bootstrap.Modal.getInstance(modalEl);
                if (bsModal) bsModal.hide();

                // 移除空資料列
                const emptyRow = document.getElementById("emptyRow");
                if (emptyRow) emptyRow.remove();

                // 動態將新物料插入表格最頂端
                const tbody = document.getElementById("inventoryTableBody");
                const newTr = document.createElement("tr");
                newTr.id = `row-item-${data.item.id}`;
                newTr.className = "table-success-highlight";
                newTr.innerHTML = `
                    <td class="ps-4 text-muted fw-semibold">#${data.item.id}</td>
                    <td>
                        <div class="fw-bold text-dark fs-6">${data.item.itemName} <span class="badge bg-danger-subtle text-danger ms-1">New</span></div>
                        <small class="text-muted">代碼：<code>${data.item.itemCode}</code></small>
                    </td>
                    <td>
                        <span class="badge bg-light text-dark border">${data.item.category}</span>
                    </td>
                    <td>
                        <div class="fs-6 fw-bold text-dark item-quantity" id="qty-${data.item.id}">
                            ${data.item.stockQuantity} <span class="fs-6 font-normal text-muted">${data.item.unit}</span>
                        </div>
                        <small class="text-muted">安全水位：${data.item.safetyStock} ${data.item.unit}</small>
                    </td>
                    <td>
                        <span class="badge ${data.item.statusBadge} item-badge" id="badge-${data.item.id}">
                            ${data.item.statusText}
                        </span>
                    </td>
                    <td>
                        <small class="text-muted item-time" id="time-${data.item.id}">
                            ${data.item.lastUpdated}
                        </small>
                    </td>
                    <td class="text-end pe-4">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-success" onclick="openGlobalModal('/Inventory/AdjustStockModal?id=${data.item.id}&actionType=in', '物料快速入庫作業');">
                                <i class="bi bi-plus-circle me-1"></i> 入庫
                            </button>
                            <button type="button" class="btn btn-outline-danger" onclick="openGlobalModal('/Inventory/AdjustStockModal?id=${data.item.id}&actionType=out', '物料快速出庫作業');">
                                <i class="bi bi-dash-circle me-1"></i> 出庫
                            </button>
                        </div>
                    </td>
                `;
                tbody.insertBefore(newTr, tbody.firstChild);

                // 更新品項數計數器
                const badge = document.getElementById("totalCountBadge");
                if (badge) {
                    badge.textContent = parseInt(badge.textContent || "0") + 1;
                }

                // 成功提示
                Swal.fire({
                    icon: "success",
                    title: "新增成功！",
                    text: data.message,
                    timer: 2000,
                    showConfirmButton: false
                });
            } else {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-plus-circle me-1"></i> 立即新增物料';
                Swal.fire({
                    icon: "warning",
                    title: "建立失敗",
                    text: data.message
                });
            }
        })
        .catch(err => {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="bi bi-plus-circle me-1"></i> 立即新增物料';
            Swal.fire({
                icon: "error",
                title: "網路異常",
                text: err.message
            });
        });
    }

    /**
     * AJAX 提交庫存異動 (SPA-like 無刷新更新)
     */
    function submitStockAdjustment(e) {
        e.preventDefault();
        const form = document.getElementById("adjustStockForm");
        const submitBtn = document.getElementById("btnSubmitStock");
        const formData = new FormData(form);

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> 處理中...';

        fetch("/Inventory/AdjustStock", {
            method: "POST",
            body: formData,
            credentials: "same-origin"
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                // 關閉 Modal
                const modalEl = document.getElementById("globalModal");
                const bsModal = bootstrap.Modal.getInstance(modalEl);
                if (bsModal) bsModal.hide();

                // 即時局部更新表格 DOM (不跳轉)
                const qtyEl = document.getElementById(`qty-${data.itemId}`);
                const badgeEl = document.getElementById(`badge-${data.itemId}`);
                const timeEl = document.getElementById(`time-${data.itemId}`);

                if (qtyEl) qtyEl.innerHTML = `${data.newQuantity} <span class="fs-6 font-normal text-muted">${data.unit}</span>`;
                if (badgeEl) {
                    badgeEl.className = `badge ${data.statusBadge} item-badge`;
                    badgeEl.textContent = data.statusText;
                }
                if (timeEl) timeEl.textContent = data.lastUpdated;

                // 成功提示 (SweetAlert2)
                Swal.fire({
                    icon: "success",
                    title: "異動成功！",
                    text: data.message,
                    timer: 2000,
                    showConfirmButton: false
                });
            } else {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i> 重新提交';
                Swal.fire({
                    icon: "error",
                    title: "作業失敗",
                    text: data.message
                });
            }
        })
        .catch(err => {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i> 重新提交';
            Swal.fire({
                icon: "error",
                title: "網路異常",
                text: err.message
            });
        });
    }
</script>
}
