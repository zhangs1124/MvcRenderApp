@inject IWebHostEnvironment Env
@using MvcRenderApp.Models
@{
    ViewData["Title"] = "系統儀表板";
    int totalItems = ViewBag.TotalItems ?? 0;
    int warningItems = ViewBag.WarningItems ?? 0;
    int outOfStock = ViewBag.OutOfStockItems ?? 0;
    var recentItems = ViewBag.RecentItems as List<InventoryItem> ?? new List<InventoryItem>();
}

<div class="container-fluid px-0">
    <!-- 歡迎橫幅 -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: linear-gradient(135deg, #1e3d5c 0%, #2b5177 100%); color: #fff;">
        <div class="card-body p-4 p-lg-5">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <span class="badge bg-info text-dark px-3 py-2 mb-3 fw-bold rounded-pill">
                        <i class="bi bi-rocket-takeoff-fill me-1"></i> ASP.NET Core 8.0 + SQLite + Render 雙環境
                    </span>
                    <h2 class="fw-bold mb-2 text-white">歡迎使用 庫存雲端管家 (Inventory Flow)</h2>
                    <p class="text-white-50 mb-0 fs-6">
                        本專案已完成基底版面、SQLite 資料庫與 Render 雙環境配置！所有操作流程已整合於 <code>doc/TUTORIAL_GUIDE.md</code>。
                    </p>
                </div>
                <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                    <a href="/healthz" target="_blank" class="btn btn-light px-4 py-2 fw-bold text-primary shadow-sm me-2">
                        <i class="bi bi-heart-pulse-fill me-1 text-danger"></i> 健康探針
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 4 大核心 KPI 指標卡 (連接 SQLite 真實數據) -->
    <div class="row g-4 mb-4">
        <!-- 指標 1 -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-card p-4 h-100 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold mb-1">庫存管理品項數</div>
                    <h3 class="fw-bold mb-0 text-dark">@totalItems <small class="fs-6 text-muted font-normal">品項</small></h3>
                    <small class="text-success"><i class="bi bi-database-check me-1"></i>SQLite 資料庫就緒</small>
                </div>
                <div class="kpi-icon-box bg-primary-subtle text-primary">
                    <i class="bi bi-boxes"></i>
                </div>
            </div>
        </div>

        <!-- 指標 2 -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-card p-4 h-100 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold mb-1">低水位庫存警戒</div>
                    <h3 class="fw-bold mb-0 text-warning">@warningItems <small class="fs-6 text-muted font-normal">品項</small></h3>
                    <small class="text-danger fw-semibold"><i class="bi bi-exclamation-triangle-fill me-1"></i>含 @outOfStock 項斷貨</small>
                </div>
                <div class="kpi-icon-box bg-warning-subtle text-warning">
                    <i class="bi bi-bell-fill"></i>
                </div>
            </div>
        </div>

        <!-- 指標 3 -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-card p-4 h-100 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold mb-1">今日異動記帳</div>
                    <h3 class="fw-bold mb-0 text-dark">即時 <small class="fs-6 text-muted font-normal">連線</small></h3>
                    <small class="text-muted"><i class="bi bi-lightning-charge me-1"></i>EF Core 自動管理</small>
                </div>
                <div class="kpi-icon-box bg-info-subtle text-info">
                    <i class="bi bi-arrow-left-right"></i>
                </div>
            </div>
        </div>

        <!-- 指標 4 -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-card p-4 h-100 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold mb-1">雲端伺服器狀態</div>
                    <h3 class="fw-bold mb-0 text-success">Healthy</h3>
                    <small class="text-success fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>Render 容器活躍</small>
                </div>
                <div class="kpi-icon-box bg-success-subtle text-success">
                    <i class="bi bi-cpu-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- 最近異動摘要與架構對照 -->
    <div class="row g-4">
        <!-- 左側：即時種子資料預覽 (防擠壓表格展示) -->
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-box-seam me-2 text-primary"></i> 庫存種子資料清單 (SQLite)
                    </h5>
                    <span class="badge bg-primary-subtle text-primary">即時連線</span>
                </div>
                <div class="card-body p-4">
                    <div class="responsive-table-wrapper">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>物料代碼 / 品名</th>
                                    <th>分類</th>
                                    <th>現有存量 / 水位</th>
                                    <th>狀態</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in recentItems)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@item.ItemName</div>
                                            <small class="text-muted"><code>@item.ItemCode</code></small>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@item.Category</span></td>
                                        <td>
                                            <span class="fw-bold">@item.StockQuantity @item.Unit</span>
                                            <small class="text-muted ps-1">(安全: @item.SafetyStock)</small>
                                        </td>
                                        <td>
                                            <span class="badge @item.StatusBadgeClass">@item.StatusText</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 右側：TUTORIAL_GUIDE 指引卡片 -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100 border-start border-4 border-primary">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-journal-bookmark-fill me-2 text-primary"></i> 完整教學手冊已就緒
                    </h5>
                </div>
                <div class="card-body p-4">
                    <p class="text-secondary small mb-3">
                        所有 Render 串接、雙環境配置與第一個 PR 演練流程已完整寫入教學檔：
                    </p>
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <div class="fw-bold text-primary mb-1">
                            <i class="bi bi-file-earmark-text-fill me-1"></i> doc/TUTORIAL_GUIDE.md
                        </div>
                        <small class="text-muted">包含：GitHub 遠端推送、Render Blueprint 一鍵發布、Branch Rulesets 防護、Issue ➔ PR 自動閉環實戰。</small>
                    </div>
                    <div class="d-grid">
                        <a href="javascript:void(0);" onclick="Swal.fire({icon: 'success', title: '教學手冊', text: '請在專案目錄下點擊開啟 doc/TUTORIAL_GUIDE.md 查閱完整 SOP！'});" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-info-circle me-1"></i> 查看教學檔導覽說明
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
